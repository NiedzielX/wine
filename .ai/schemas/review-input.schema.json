{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wine-match/review-input/1",
  "title": "Reviewer input package (lesson 21)",
  "description": "What every reviewer of one round gets, identical for all of them. There is deliberately no field for the author's rationale, PR description, commit messages or another reviewer's output: additionalProperties is false, so such a field fails validation. Protocol: .ai/docs/review-protocol.md section 9.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "subject", "round", "risk", "spec", "acceptanceCriteria", "rules", "diff", "findingsRequested"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "review-input" },
    "subject": { "enum": ["spec", "code"] },
    "round": { "type": "integer", "minimum": 1, "maximum": 3 },
    "risk": { "enum": ["risk-low", "risk-medium", "risk-high"] },
    "baseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "spec": { "type": "string", "minLength": 1 },
    "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "rules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "diff": { "type": "string" },
    "findingsRequested": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 0, "maximum": 20 },
        "max": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    }
  }
}
