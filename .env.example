# Data source for the app: "memory" (demo data, no database) or "postgres"
DATA_SOURCE=memory

# PostgreSQL connection (required when DATA_SOURCE=postgres, for migrations, seeding and DB tests)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/winematch

# Connection pool size per app instance
DB_POOL_MIN=2
DB_POOL_MAX=10

# Log SQL queries (true/false)
DB_DEBUG=false

# Dashboard sign-in. The session cookie is always httpOnly and SameSite=Lax; it is Secure in production.
# Set false only to run a production build over plain http (e.g. on localhost); never on a public server.
AUTH_COOKIE_SECURE=false

# Real accounts: USER_PASSWORD='a long passphrase' npm run user:create -- --email jan@example.com \
#   --name "Jan Kowalski" --role sommelier --restaurant halka     (roles: owner, manager, sommelier, waiter)
# The demo accounts (marta@halka.pl, tomasz@halka.pl, kelner@halka.pl) come from `npm run db:seed` and
# DATA_SOURCE=memory and share a PUBLIC password: never seed a real installation.

# The public address of this installation. QR codes point to PUBLIC_BASE_URL/r/<restaurant>.
# Set it to your real address (https://wine.example.com) BEFORE printing any QR codes.
PUBLIC_BASE_URL=http://localhost:3000
# In PRODUCTION (npm start) the server refuses to start unless PUBLIC_BASE_URL is an https:// address with a public
# domain name (no IP address, no single-label host such as localhost, no .local/.localhost/.internal/.lan/.home.arpa):
# a QR code printed with a wrong address cannot be fixed. AUTH_COOKIE_SECURE=false does NOT excuse it. For a local run
# of a built app (this file's localhost address), a CI job or a test, say so on purpose; the start then logs a warning:
# ALLOW_LOCAL_BASE_URL=true

# Logging: debug | info | warn | error (default: debug in development, info in production).
# Every line is JSON and secrets are redacted before anything is written.
LOG_LEVEL=info

# Demo data in production. DATA_SOURCE=memory serves demo accounts with a PUBLIC password, so a production
# server refuses to start on it unless you say so on purpose (a demo installation). Production also requires
# DATA_SOURCE to be set explicitly: a typo must never silently pick the demo data.
# ALLOW_DEMO_DATA=true   (also needed to run a BUILT app locally on demo data: DATA_SOURCE=memory ALLOW_DEMO_DATA=true npm start)

# Where the bare address (/) sends visitors. Default: halka.
# DEMO_RESTAURANT_SLUG=halka

# Prometheus-format metrics at GET /api/v1/metrics (Authorization: Bearer <token>). Unset = the endpoint answers 404.
# At least 32 characters, e.g. from `openssl rand -hex 32`. Never reuse another secret.
# METRICS_TOKEN=

# Request limits per client (E21 F3; docs/DEPLOYMENT.md sections 4 and 6). All optional; no value here is required.
# TRUSTED_PROXY_HOPS: how many reverse proxies in front of the app APPEND the client address to X-Forwarded-For. 0 (default) = the header is
#   never read (a client could write anything into it) and every client shares ONE counter at half the limits: one client can then lock
#   out everyone for the window. Deployments without docker-compose.yml MUST set it. docker-compose.yml sets 1
#   (the app listens on 127.0.0.1 behind the host proxy). Never set more than the real number of proxies: that lets a client choose its address.
# TRUSTED_PROXY_HOPS=0
# RATE_LIMIT_SECRET: key of the client hash (the IP is never stored or logged; the key changes every UTC day). Unset = a random key per
#   process (counters restart with it, and each instance counts on its own: the effective limit is limit x number of instances). At least 32 characters: `openssl rand -hex 32`.
# RATE_LIMIT_SECRET=
# RATE_LIMITS: override the defaults, `rule=limit/windowSeconds`, comma-separated. Rules and defaults: public-api=120/60, login=20/600,
#   code-issue=60/600, code-lookup=60/600, code-mark=30/600, pin-login=60/600. A typo stops the start.
# RATE_LIMITS=
# RATE_LIMIT_MAX_CLIENTS: distinct clients per rule and window with their own counter (default 10000). Past it every NEW client of that
#   rule shares one counter with the same limit (degraded mode, logged at most once a minute): it bounds the table under a flood of addresses.
# RATE_LIMIT_MAX_CLIENTS=

# Public sales pages under /demo (E22). off (default, unset): every /demo address answers 404.
# calculator: the return calculator /demo/roi and its printable summary; it reads no data, so it may run next to real restaurants.
# demo: also the guide /demo, the tour /demo/tour and a ribbon on the guest pages of the invented restaurant Halka. Read-only: it loads no demo
#   accounts, switches sign-in off and records no guest events (recommendation codes are still issued in memory). All its pages are noindex.
#   DEMO_RESTAURANT_SLUG must be "halka" (or unset) in this mode. It needs DATA_SOURCE=memory AND ALLOW_DEMO_DATA=true, never real restaurants.
# Any other value stops the start (a typo must never switch a public section on).
# SHOWCASE_MODE=calculator


# ---- Production with Docker Compose (docker-compose.yml, docs/DEPLOYMENT.md) ----
# `cp .env.example .env`, then set the lines below. docker-compose.yml fixes NODE_ENV=production, DATA_SOURCE=postgres,
# AUTH_COOKIE_SECURE=true, ALLOW_LOCAL_BASE_URL=false and ALLOW_DEMO_DATA=false for the app and the migrate job, and builds DATABASE_URL
# from the POSTGRES_* values, so the localhost values above (DATABASE_URL, AUTH_COOKIE_SECURE=false) are ignored there.
# Required for Compose (the stack refuses to start without them):
#   PUBLIC_BASE_URL=https://wine.example.com        (above: the public https address, set BEFORE printing any QR code)
#   POSTGRES_PASSWORD=<openssl rand -hex 24>        (letters and digits only: it is placed in a URL)
# Recommended: DEMO_RESTAURANT_SLUG=<slug of the pilot restaurant> (where "/" sends visitors; the production smoke checks it),
#   METRICS_TOKEN=<openssl rand -hex 32>, RATE_LIMIT_SECRET=<openssl rand -hex 32>, LOG_LEVEL=info
# Optional: POSTGRES_USER (default winematch), POSTGRES_DB (default winematch), APP_PORT (default 3000, bound to 127.0.0.1),
#   WINE_MATCH_TAG (image tag, default local: use the git tag of the release, see "Rollback" in docs/DEPLOYMENT.md)
# Demo profile only (a separate instance): DEMO_PUBLIC_BASE_URL=https://demo.example.com, DEMO_PORT (default 3001)
