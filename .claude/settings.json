{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.env.*.local)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)"
    ]
  },
  "sandbox": {
    "enabled": false,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": false,
    "filesystem": {
      "denyRead": ["~/.ssh", "~/.aws", "~/.config/gh", "~/.kube", "~/.npmrc", "~/.pypirc"]
    },
    "network": {
      "allowedDomains": ["github.com", "api.github.com", "codeload.github.com", "objects.githubusercontent.com", "registry.npmjs.org"],
      "deniedDomains": ["169.254.169.254", "metadata.google.internal"]
    },
    "excludedCommands": [
      "npm run test:db",
      "npm run test:db *",
      "npm run test:e2e",
      "npm run test:e2e *",
      "npm run smoke *",
      "npm run boot:check",
      "npm run db:migrate",
      "npm run db:seed",
      "npm run dev",
      "npm run start"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-tool-use.mjs" }
        ]
      }
    ]
  }
}
